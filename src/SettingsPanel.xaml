<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="300" Margin="10" Background="{DynamicResource C171B23}" BorderBrush="{DynamicResource C343B47}" BorderThickness="1" CornerRadius="16" TextElement.FontFamily="Segoe UI" TextElement.Foreground="{DynamicResource CE8ECF2}">
 <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25"/></Border.Effect>
 <Border.Resources>
  <Style TargetType="RadioButton">
   <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource CA0AABA}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Choice" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="5,7"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource C29313D}"/><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource C00B8FC}"/><Setter Property="Foreground" Value="{DynamicResource CF4F7FC}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource C29313D}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource C00B8FC}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PanelButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource CB0BAC8}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" Padding="10,7" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource C29313D}"/><Setter Property="Foreground" Value="{DynamicResource CF4F7FC}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource C29313D}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SliderTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderThumb" TargetType="Thumb"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Knob" Background="{DynamicResource C00B8FC}" BorderBrush="{DynamicResource C89DEFF}" BorderThickness="2" CornerRadius="7"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Background" Value="{DynamicResource C79DBFF}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource CFFFFFF}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="0,0,0,0"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="{DynamicResource C00B8FC}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="{DynamicResource C303743}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource CDDE4EF}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="SwitchTrack" Grid.Column="1" Height="18" Width="32" CornerRadius="9" Background="{DynamicResource C343D4A}" VerticalAlignment="Center"><Ellipse x:Name="SwitchKnob" Width="12" Height="12" Fill="{DynamicResource CBAC5D4}" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource C00B8FC}"/><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource CFFFFFF}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource CC2ECFF}"/><Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Border.Resources>
 <StackPanel Margin="20,15,20,16">
  <Grid Margin="0,0,0,14"><TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseSettings" Style="{StaticResource PanelButton}" Content="&#x00D7;" FontSize="18" HorizontalAlignment="Right" Margin="0,-6,-9,-6" AutomationProperties.Name="Close settings"/></Grid>
  <TextBlock Text="APPEARANCE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource C8795A9}" Margin="0,0,0,12"/>
  <TextBlock Text="Theme" FontSize="12" Margin="0,0,0,8"/>
  <Border Background="{DynamicResource C303743}" CornerRadius="8" Padding="3" Margin="0,0,0,15"><UniformGrid Columns="3"><RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" AutomationProperties.Name="Dark theme"/><RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" AutomationProperties.Name="Light theme"/><RadioButton x:Name="ThemeSystem" Content="Windows" GroupName="Theme" AutomationProperties.Name="Use Windows theme"/></UniformGrid></Border>
  <Grid><TextBlock Text="Opacity" FontSize="12"/><TextBlock x:Name="OpacityValue" Text="100%" Foreground="{DynamicResource AccentText}" FontSize="12" HorizontalAlignment="Right"/></Grid>
  <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Margin="0,5,0,12" AutomationProperties.Name="Widget opacity"/>
  <Grid><TextBlock Text="Size" FontSize="12"/><TextBlock x:Name="SizeValue" Text="100%" Foreground="{DynamicResource AccentText}" FontSize="12" HorizontalAlignment="Right"/></Grid>
  <Slider x:Name="SizeSlider" Minimum="75" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" Margin="0,5,0,8" AutomationProperties.Name="Widget size"/>
  <Border Height="1" Background="{DynamicResource C2C333E}" Margin="0,7,0,12"/>
  <TextBlock Text="BEHAVIOUR" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource C8795A9}" Margin="0,0,0,3"/>
  <CheckBox x:Name="AlwaysOnTop" Content="Always on top" AutomationProperties.Name="Always on top"/>
  <CheckBox x:Name="StartWithWindows" Content="Start with Windows" AutomationProperties.Name="Start with Windows"/>
  <CheckBox x:Name="StartInTray" Content="Start minimized in tray" AutomationProperties.Name="Start minimized in tray"/>
    <CheckBox x:Name="LowBatteryNotifications" Content="Low battery notifications" AutomationProperties.Name="Low battery notifications" ToolTip="Warn once below 10%, including in the tray. Another warning is allowed after recovery to 15%."/>
  <Border Height="1" Background="{DynamicResource C2C333E}" Margin="0,9,0,9"/>
  <Button x:Name="RefreshNow" Style="{StaticResource PanelButton}" Content="Refresh batteries now" HorizontalContentAlignment="Left"/>
  <Grid Margin="0,3,0,0"><Button x:Name="AboutButton" Style="{StaticResource PanelButton}" Content="About VoltHUD" HorizontalAlignment="Left"/><Button x:Name="QuitButton" Style="{StaticResource PanelButton}" Content="Quit" Foreground="{DynamicResource CF2A7A7}" HorizontalAlignment="Right"/></Grid>
  <TextBlock x:Name="SettingsMessage" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource CA0AABA}" Margin="0,12,0,0"/>
 </StackPanel>
</Border>
